# Copy to python/.env (never commit it). Real environment variables take precedence over this file.
# Relative paths are resolved against the python/ folder.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mb_python
DB_USER=mb
DB_PASS=
APP_STACK=python
TEST_TOKEN=
# Folder with index.html, app.js ... (the shared/public of this repo, or its deployed copy).
PUBLIC_DIR=../shared/public
# Both outside PUBLIC_DIR; writable by the app.
MEDIA_DIR=/home/example/mooban-data/media
CACHE_DIR=/home/example/mooban-data/cache
# Only used by `python app.py`; gunicorn/Passenger choose their own port.
PORT=8084
# 1 = trust exactly one X-Forwarded-For hop (only behind a reverse proxy you control).
TRUST_PROXY=0
MAX_UPLOAD_BYTES=10485760
MAX_PIXELS=24000000
SSE_POLL_MS=1000
SSE_MAX_SECONDS=60
MAX_STREAMS_PER_IP=10
