# Copy to node/.env (never committed). src/config.js loads it with process.loadEnvFile
# (Node >= 20.12, no dotenv dependency); variables already set in the real environment win.

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=mb_node
DB_USER=mb
DB_PASS=change-me

APP_STACK=node
PORT=8083
# Test token for /api/test/* and the /test page (long random string)
TEST_TOKEN=change-me-to-a-long-random-string

# Absolute paths. MEDIA_DIR and CACHE_DIR must be OUTSIDE PUBLIC_DIR.
PUBLIC_DIR=/path/to/mooban/shared/public
MEDIA_DIR=/path/to/data/media
CACHE_DIR=/path/to/data/cache

# 1 = trust X-Forwarded-For (only behind a proxy you control); default off
TRUST_PROXY=0

# Limits
MAX_UPLOAD_BYTES=10485760
MAX_PIXELS=24000000
SSE_POLL_MS=1000
SSE_MAX_SECONDS=60
MAX_STREAMS_PER_IP=10
